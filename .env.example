# https://dashboard.api-football.com/ üzerinden alın
API_FOOTBALL_KEY=your_api_key_here
# 2026/27 sezonu başlangıç yılı
API_FOOTBALL_SEASON=2026

# Local Phase 17 PostgreSQL; choose your own password in .env
POSTGRES_DB=fantasy_league
POSTGRES_USER=fantasy_league
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://fantasy_league:replace_with_a_unique_local_password@127.0.0.1:5433/fantasy_league
# Explicit rollback option: change to sqlite only when intentionally using the legacy store.
STORAGE_BACKEND=postgres

# Optional pgAdmin profile
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace_with_a_different_password
PGADMIN_PORT=5050
